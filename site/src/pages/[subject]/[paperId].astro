---
/**
 * site/src/pages/[subject]/[paperId].astro
 *
 * Individual paper page with full content and SEO metadata.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveSubjects, loadSubjectsConfig } from '../../lib/data.js';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const subjects = getActiveSubjects();
  const paths = [];

  for (const subject of subjects) {
    const papersDir = path.join(process.cwd(), '..', 'data', 'papers');
    const subjectDataDir = path.join(process.cwd(), '..', 'data', 'subjects', subject.code);

    // Load the subject's index to get all paper IDs
    const indexPath = path.join(subjectDataDir, 'index.json');
    if (!fs.existsSync(indexPath)) continue;

    const index = JSON.parse(fs.readFileSync(indexPath, 'utf-8'));
    const allPaperIds = new Set();

    // Collect all paper IDs from all dates
    for (const dateFile of index.dates) {
      const datePath = path.join(subjectDataDir, `${dateFile}.json`);
      if (!fs.existsSync(datePath)) continue;

      const dateData = JSON.parse(fs.readFileSync(datePath, 'utf-8'));
      dateData.paper_ids.forEach(id => allPaperIds.add(id));
    }

    // Load each paper and create a path
    for (const paperId of allPaperIds) {
      const paperPath = path.join(papersDir, `${paperId}.json`);
      if (!fs.existsSync(paperPath)) continue;

      const paper = JSON.parse(fs.readFileSync(paperPath, 'utf-8'));

      paths.push({
        params: { subject: subject.slug, paperId },
        props: { paper, subjectConfig: subject }
      });
    }
  }

  return paths;
}

const { paper, subjectConfig } = Astro.props;
const { subject, paperId } = Astro.params;

const pageTitle = `${paper.title_relatable || paper.title_original} — The Brief`;
const pageDescription = paper.hook || paper.summary?.substring(0, 160) || '';
const canonicalURL = `https://the-brief.pages.dev/${subject}/${paperId}/`;

// Format date for JSON-LD
const datePublished = new Date(paper.announced_date + 'T00:00:00Z').toISOString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "headline": paper.title_relatable || paper.title_original,
  "author": paper.authors,
  "datePublished": datePublished,
  "description": pageDescription,
  "url": canonicalURL,
  "isBasedOn": paper.arxiv_url,
  "publisher": {
    "@type": "Organization",
    "name": "The Brief"
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogType="article"
  ogTitle={paper.title_relatable || paper.title_original}
  ogDescription={pageDescription}
  ogUrl={canonicalURL}
  jsonLd={jsonLd}
>
  <style>
    body{padding:40px 20px}

    .container{max-width:680px;margin:0 auto}

    .nav-link{display:inline-block;font-family:var(--mono);font-size:11px;
      letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);
      text-decoration:none;margin-bottom:32px;border-bottom:1px solid transparent;
      transition:all .15s}
    .nav-link:hover{color:var(--accent);border-bottom-color:var(--accent)}

    .paper-meta{font-family:var(--mono);font-size:11px;letter-spacing:.05em;
      text-transform:uppercase;color:var(--ink-faint);margin-bottom:12px}

    h1{font-family:var(--display);font-size:42px;line-height:1.1;
      font-weight:400;letter-spacing:-.01em;margin-bottom:16px}

    .authors{font-style:italic;color:var(--ink-soft);font-size:16px;margin-bottom:24px}
    .date{font-family:var(--mono);font-size:13px;color:var(--ink-faint);margin-bottom:32px}

    .summary{font-size:19px;line-height:1.65;margin-bottom:32px;
      padding-top:24px;border-top:2px solid var(--rule)}
    .summary em{font-style:italic}

    .citation{padding:20px;background:rgba(0,0,0,.02);border:1px solid var(--rule);
      border-radius:6px;font-size:15px;line-height:1.6;margin-bottom:32px}
    .cite-label{font-family:var(--mono);font-size:10px;letter-spacing:.15em;
      text-transform:uppercase;color:var(--ink-faint);display:block;margin-bottom:8px}
    .citation a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule)}
    .citation a:hover{color:var(--accent);border-bottom-color:var(--accent)}
    .citation em{font-style:italic}
    .arxiv-id{font-family:var(--mono);font-size:12px;color:var(--ink-faint);margin-left:6px}

    .paper-link{display:inline-block;font-family:var(--mono);font-size:12px;
      letter-spacing:.05em;padding:10px 18px;background:var(--accent);color:var(--bg);
      text-decoration:none;border-radius:4px;transition:opacity .15s}
    .paper-link:hover{opacity:.85}

    @media(max-width:768px){
      body{padding:24px 16px}
      h1{font-size:32px}
      .summary{font-size:17px}
    }
  </style>

  <div class="container">
    <a href={`/${subject}/`} class="nav-link">← Back to {subjectConfig.name}</a>

    <div class="paper-meta">{subjectConfig.code}</div>

    <h1>{paper.title_relatable || paper.title_original}</h1>

    <p class="authors">{paper.authors}</p>
    <p class="date">{new Date(paper.announced_date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>

    <div class="summary" set:html={paper.summary || paper.hook || ''}></div>

    <div class="citation">
      <span class="cite-label">Published as</span>
      <a href={paper.arxiv_url} target="_blank" rel="noopener noreferrer">
        <em>{paper.title_original}</em>
      </a>
      <span class="arxiv-id">arXiv:{paper.id}</span>
    </div>

    <a href={paper.arxiv_url} target="_blank" rel="noopener noreferrer" class="paper-link">
      Read the original paper →
    </a>
  </div>
</BaseLayout>
