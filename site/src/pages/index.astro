// Sort buttons
document.getElementById('sort-btns').addEventListener('click', e => {
  const btn = e.target.closest('button[data-sort]');
  if (!btn) return;
  state.sort = btn.dataset.sort;
  document.querySelectorAll('#sort-btns button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  render();
});

// Collapse/expand all buttons (event delegation)
document.addEventListener('click', e => {
  if (e.target.id === 'collapse-all' || e.target.closest('#collapse-all')) {
    bulkToggle(true);
  } else if (e.target.id === 'expand-all' || e.target.closest('#expand-all')) {
    bulkToggle(false);
  }
});

// Search (debounced)
let searchTimer;
function handleSearch(val) {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => { state.search = val.trim(); render(); }, 200);
}
document.getElementById('sb-search').addEventListener('input',  e => handleSearch(e.target.value));
document.getElementById('mob-search').addEventListener('input', e => handleSearch(e.target.value));

// Click on collapsed title to expand
document.getElementById('feed').addEventListener('click', e => {
  const card = e.target.closest('.full-card.collapsed, .brief-row.collapsed');
  if (!card) return;
  const title = e.target.closest('.card-title, h3');
  if (title) {
    const id = card.dataset.id;
    togglePaper(id, card);
  }
});

