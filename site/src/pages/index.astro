// ═══════════════════════════════════════════════════
// SCROLL SPY
// ═══════════════════════════════════════════════════
function initScrollSpy() {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const date = e.target.dataset.date;

        // Update button styles
        document.querySelectorAll('[id^="date-btn-"]').forEach(btn => {
          if (btn.dataset.date === date) {
            btn.style.background = 'var(--accent)';
            btn.style.color = 'var(--bg)';
            btn.style.borderColor = 'var(--accent)';
          } else {
            btn.style.background = 'transparent';
            btn.style.color = 'var(--ink-soft)';
            btn.style.borderColor = 'var(--rule)';
          }
        });
      }
    });
  }, { threshold: 0.1, rootMargin: '-20% 0px -60% 0px' });

  document.querySelectorAll('.day-section').forEach(el => obs.observe(el));
}

